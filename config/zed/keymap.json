[
  {
    "context": "Workspace",
    "bindings": {
      "f5": "debugger::Start",
      "f1": "debugger::StepInto",
      "f2": "debugger::StepOver",
      "f3": "debugger::StepOut",
      "f7": "debug_panel::ToggleFocus",
      "f9": ["task::Spawn", { "task_name": "Spring Boot: Run" }],
      "f10": ["task::Spawn", { "task_name": "Spring Boot: Debug" }]
    }
  },
  {
    "context": "Workspace && debugger_stopped",
    "bindings": {
      "f5": "debugger::Continue",
      "f1": "debugger::StepInto",
      "f2": "debugger::StepOver",
      "f3": "debugger::StepOut"
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "shift-h": "vim::FirstNonWhitespace",
      "shift-l": "vim::EndOfLine",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "space y": "editor::Copy",
      "space c a": "editor::ToggleCodeActions",
      "space l f": "editor::Format",
      "space s j": "editor::JoinLines",
      "space o a": "assistant::InlineAssist",
      "space o s": "agent::ToggleNewThreadMenu",
      "space o r": "agent::AddSelectionToThread"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "shift-j": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "shift-k": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z"],
      "shift-n": ["workspace::SendKeystrokes", "shift-n z z"],
      "z j": ["workspace::SendKeystrokes", "o escape"],
      "z k": ["workspace::SendKeystrokes", "shift-o escape"],
      "x": ["workspace::SendKeystrokes", "\" _ x"],
      "space shift-y": "vim::YankLine",
      "space w": "workspace::SaveAll",
      "alt-r": ["task::Spawn", { "task_name": "Run Python File" }],

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-\\": "workspace::ActivatePreviousPane",

      "ctrl-up": "vim::ResizePaneUp",
      "ctrl-down": "vim::ResizePaneDown",
      "ctrl-right": "vim::ResizePaneRight",
      "ctrl-left": "vim::ResizePaneLeft",

      "space l w": "editor::ToggleSoftWrap",
      "space a n": "editor::ToggleLineNumbers",
      "space a shift-n": "editor::ToggleRelativeLineNumbers",
      "space a z": "workspace::ToggleZoom",
      "space t o": "terminal_panel::ToggleFocus",

      "g h": "editor::Hover",
      "g d": "editor::GoToDefinition",
      "g shift-d": "editor::GoToTypeDefinition",
      "g i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences",
      "space r n": "editor::Rename",
      "space d f": "editor::Hover",
      "space l x": "editor::ToggleInlineDiagnostics",

      "space c c": "editor::ToggleComments",

      "\\": "project_panel::ToggleFocus",
      "\\ \\": "pane::RevealInProjectPanel",
      "space e e": "project_panel::ToggleFocus",

      "shift-b": "tab_switcher::Toggle",
      "space q a": "pane::CloseActiveItem",
      "space q shift-a": "pane::CloseAllItems",
      "space q o": "pane::CloseOtherItems",

      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f w": ["pane::DeploySearch", { "whole_word": true }],
      "space f s": "buffer_search::Deploy",
      "space f o": "outline::Toggle",
      "space f m": "outline::Toggle",
      "space f shift-w": "project_symbols::Toggle",
      "space f d": "diagnostics::Deploy",
      "space f i": "call_hierarchy::ShowIncomingCalls",
      "space f h": "command_palette::Toggle",
      "space p k": "zed::OpenKeymap",
      "space t h": "theme_selector::Toggle",
      "space ' '": "projects::OpenRecent",

      "space t p": "diagnostics::Deploy",
      "space t shift-p": "diagnostics::Deploy",
      "space t s": "outline_panel::ToggleFocus",
      "space t l": "project_symbols::Toggle",
      "space t shift-l": "diagnostics::Deploy",
      "space t shift-q": "diagnostics::Deploy",

      "space l g": ["task::Spawn", { "task_name": "Lazygit", "reveal_target": "center" }],
      "space g l": ["task::Spawn", { "task_name": "Lazygit Log", "reveal_target": "center" }],
      "space g b r": "git::Branch",
      "space g i": ["task::Spawn", { "task_name": "GitHub Issues (open)" }],
      "space g shift-i": ["task::Spawn", { "task_name": "GitHub Issues (all)" }],
      "space g p": ["task::Spawn", { "task_name": "GitHub PRs (open)" }],
      "space g shift-p": ["task::Spawn", { "task_name": "GitHub PRs (all)" }],

      "space b": "editor::ToggleBreakpoint",
      "space shift-b": "editor::EditLogBreakpoint",
      "space d r": "debugger::ClearAllBreakpoints",
      "space d a": "debugger::FocusBreakpointList",
      "space d v": "debugger::FocusVariables",
      "space d c": "debugger::Continue",
      "space ?": "debugger::EvaluateSelectedText",

      "space o o": "agent::ToggleFocus",
      "space o r r": "agent::AddSelectionToThread",
      "space o u": "agent::ScrollOutputPageUp",
      "space o d": "agent::ScrollOutputPageDown"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "p": ["vim::Paste", { "preserve_clipboard": true }],
      "<": "editor::Outdent",
      ">": "editor::Indent",
      "space c": "vim::ToggleComments",
      "space ?": "debugger::EvaluateSelectedText"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-space": "editor::ShowCompletions",
      "alt-shift-j": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !(showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-n": "editor::ShowCompletions",
      "ctrl-p": "editor::ShowCompletions"
    }
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-e": "editor::Cancel",
      "ctrl-n": "editor::ContextMenuNext",
      "ctrl-p": "editor::ContextMenuPrevious",
      "down": "editor::ContextMenuNext",
      "up": "editor::ContextMenuPrevious",
      "ctrl-b": "editor::ContextMenuFirst",
      "ctrl-f": "editor::ContextMenuLast"
    }
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
      "enter": "editor::ConfirmCompletion",
      "tab": "editor::ComposeCompletion"
    }
  },
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCodeAction",
      "enter": "editor::ConfirmCodeAction"
    }
  },
  {
    "context": "Editor && in_snippet && has_next_tabstop && !showing_completions",
    "bindings": {
      "tab": "editor::NextSnippetTabstop"
    }
  },
  {
    "context": "Editor && in_snippet && has_previous_tabstop && !showing_completions",
    "bindings": {
      "shift-tab": "editor::PreviousSnippetTabstop"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "alt-shift-j": "editor::AcceptEditPrediction",
      "alt-]": "editor::NextEditPrediction",
      "alt-[": "editor::PreviousEditPrediction"
    }
  },
  {
    "context": "FileFinder || (FileFinder > Picker > Editor)",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious"
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "d": "tab_switcher::CloseSelectedItem",
      "escape": "menu::Cancel"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "\\": "project_panel::ToggleFocus",
      "space e e": "project_panel::ToggleFocus",
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "space t s": "outline_panel::ToggleFocus",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-\\ ctrl-n": "terminal::ToggleViMode",
      "alt-escape": "terminal::ToggleViMode",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  }
]
