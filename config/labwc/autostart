#!/usr/bin/env sh

# labwc autostart script for desk-btw / fedora-btw.
# Executed by labwc with the current session environment.

# Input method (fcitx5) for CJK/Vietnamese typing.
fcitx5 -d >/dev/null 2>&1 &

# NetworkManager applet.
# nm-applet >/dev/null 2>&1 &

kanshi >/dev/null 2>&1 &

# Noctalia desktop shell (bar, launcher, notifications, wallpaper).
noctalia --daemon >/dev/null 2>&1 &
