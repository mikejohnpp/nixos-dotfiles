##
## Environment variables for the labwc session (desk-btw).
## See labwc-environment(5) / /usr/share/doc/labwc/environment for full docs.
##

# Keyboard layout (matches system xkb.layout = "us").
XKB_DEFAULT_LAYOUT=us

TZ=Asia/Ho_Chi_Minh

# Cursor theme and size (matches home.pointerCursor in desk-dev).
XCURSOR_THEME=breeze_cursors
XCURSOR_SIZE=24

# Force GTK4 internal composing instead of requiring an input method.
# This is required for simple compose sequences in Qt/GTK apps.
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
XMODIFIERS=@im=fcitx

# Qt/Dolphin theming via native kde platform theme + Noctalia KColorScheme
# (mirrors ~/.config/environment.d/10-qtct.conf for systemd/portal apps).
# NOTE: no QT_STYLE_OVERRIDE — the KColorScheme in kdeglobals owns the colors.
QT_QPA_PLATFORMTHEME=kde
XDG_MENU_PREFIX=plasma-
