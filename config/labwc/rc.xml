<labwc_config>

  <core>
    <gap>4</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <primarySelection>yes</primarySelection>
  </core>

  <placement>
    <policy>cascade</policy>
  </placement>

  <theme>
    <fallbackAppIcon>labwc</fallbackAppIcon>
    <cornerRadius>8</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>none</maximizedDecoration>
    <dropShadows>no</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <font place="ActiveWindow">
      <name>FiraMono Nerd Font Propo</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
    <font place="InactiveWindow">
      <name>FiraMono Nerd Font Propo</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
    <font place="MenuHeader">
      <name>FiraMono Nerd Font Propo</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>FiraMono Nerd Font Propo</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
    <font place="OnScreenDisplay">
      <name>FiraMono Nerd Font Propo</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
  </theme>

  <windowSwitcher preview="no" outlines="yes" unshade="yes">
    <osd show="yes" style="thumbnail" output="all" thumbnailLabelFormat="%t" />
  </windowSwitcher>

  <focus>
    <followMouse>no</followMouse>
  </focus>

  <desktops>
    <popupTime>0</popupTime>
    <number>5</number>
    <prefix>Workspace</prefix>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
      <name>5</name>
    </names>
  </desktops>

  <keyboard>
    <numlock>on</numlock>
    <layoutScope>global</layoutScope>
    <repeatRate>35</repeatRate>
    <repeatDelay>200</repeatDelay>

    <!-- Windows-style Alt+Tab window switching (shows preview overlay) -->
    <keybind key="A-Tab">
      <action name="NextWindow" workspace="all" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" workspace="all" />
    </keybind>

    <!-- Terminal / apps (matches niri binds) -->
    <keybind key="W-Return">
      <action name="Execute" command="ghostty" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="dolphin" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="firefox" />
    </keybind>

    <!-- Noctalia launcher / clipboard (uncomment when running noctalia) -->
    <keybind key="W-d">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="noctalia msg panel-toggle clipboard" />
    </keybind>

    <!-- Minimize current window -->
    <keybind key="W-n">
      <action name="Iconify" />
    </keybind>

    <!-- Close window -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Fullscreen / maximize -->
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleFullscreen" />
    </keybind>

    <!-- Output control (mirrors niri binds) -->
    <keybind key="W-S-F1">
      <action name="Execute" command="wlr-randr --output eDP-1 --off" />
    </keybind>
    <keybind key="W-F1">
      <action name="Execute" command="wlr-randr --output eDP-1 --on" />
    </keybind>
    <!-- <keybind key="W-F2"> -->
    <!--   <action name="Execute" command="wl-mirror eDP-1" /> -->
    <!-- </keybind> -->

    <!-- Snap window to half screen (50%/50%) -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="W-Up">
      <action name="SnapToEdge" direction="up" combine="yes" />
    </keybind>
    <keybind key="W-Down">
      <action name="SnapToEdge" direction="down" combine="yes" />
    </keybind>

    <!-- Workspace switching -->
    <keybind key="W-Page_Down">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-Page_Up">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>

    <!-- Move window to workspace (matches niri Mod+Shift binds) -->
    <keybind key="W-S-Page_Down">
      <action name="SendToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-S-Page_Up">
      <action name="SendToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" /></keybind>

    <!-- Screenshots -->
    <keybind key="W-s">
      <action name="Execute" command="dot-screenshot region" />
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="dot-screenshot window" />
    </keybind>
    <keybind key="W-C-s">
      <action name="Execute" command="dot-screenshot monitor-focused" />
    </keybind>
    <keybind key="W-C-S-s">
      <action name="Execute" command="dot-screenshot monitor-all" />
    </keybind>

    <!-- Media / volume (matches niri wpctl binds) -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" />
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute" command="playerctl play-pause" />
    </keybind>
    <keybind key="XF86AudioStop">
      <action name="Execute" command="playerctl stop" />
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute" command="playerctl previous" />
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute" command="playerctl next" />
    </keybind>

    <!-- Brightness -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl --class=backlight set +10%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl --class=backlight set 10%-" />
    </keybind>

    <!-- Root menu -->
    <keybind key="A-Space">
      <action name="ShowMenu" menu="root-menu" atCursor="no" />
    </keybind>

    <!-- Quit -->
    <keybind key="W-S-e">
      <action name="Exit" />
    </keybind>
  </keyboard>

  <mouse>
    <doubleClickTime>500</doubleClickTime>

    <!--
      Load all default mouse bindings. This is what wires up the Per-window
      title-bar buttons (Iconify / Maximize / Close) and the menu buttons,
      which otherwise would not respond unless declared manually here.
      Contexts defined below override the corresponding defaults.
    -->
    <default />

    <context name="Root">
      <mousebind button="Left" action="Press">
        <!-- <action name="ShowMenu" menu="root-menu" /> -->
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="GoToDesktop" to="left" wrap="yes" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="GoToDesktop" to="right" wrap="yes" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <tap>yes</tap>
      <naturalScroll>no</naturalScroll>
      <scrollFactor>1.0</scrollFactor>
    </device>

    <device category="touchpad">
      <tap>yes</tap>
      <naturalScroll>yes</naturalScroll>
      <scrollFactor>1.0</scrollFactor>
    </device>
  </libinput>

  <windowRules>
    <!-- <windowRule identifier="*" serverDecoration="no" /> -->
  </windowRules>

  <menu>
    <ignoreButtonReleasePeriod>250</ignoreButtonReleasePeriod>
    <showIcons>yes</showIcons>
  </menu>

</labwc_config>
